{
  "description": "Blindness filter word lists and patterns (SPEC.md Principle 7, M4). All matching is case-insensitive. Terms in always_refuse_terms refuse a query or fact on their own. Terms in quantity_terms refuse only together with an event_terms hit or a measurement_pattern hit (so reference sizes like spacesuit height stay allowed). Regex lists use Python re syntax.",
  "always_refuse_terms": [
    "fake",
    "faked",
    "fakes",
    "faking",
    "hoax",
    "staged",
    "cgi",
    "ai-generated",
    "ai generated",
    "slowed",
    "slow motion",
    "slow-motion",
    "slowmotion",
    "sped up",
    "speed up",
    "playback speed",
    "frame rate",
    "frame-rate",
    "framerate",
    "debunk",
    "fact-check",
    "fact check",
    "factcheck",
    "hang time",
    "hangtime",
    "air time",
    "airtime",
    "in the air",
    "world record"
  ],
  "event_terms": [
    "jump",
    "jumps",
    "jumped",
    "jumping",
    "fall",
    "falls",
    "falling",
    "fell",
    "flight",
    "flights",
    "stunt",
    "stunts",
    "salute",
    "record",
    "records",
    "moon landing",
    "this",
    "viral",
    "video",
    "videos",
    "footage",
    "clip",
    "clips",
    "broadcast",
    "airborne"
  ],
  "quantity_terms": [
    "how high",
    "how far",
    "how long",
    "how fast",
    "how tall",
    "height",
    "distance",
    "speed",
    "velocity",
    "hang",
    "acceleration",
    "gravity",
    "tall",
    "high",
    "far",
    "fast",
    "long"
  ],
  "measurement_pattern": "\\d[\\d,]*(?:\\.\\d+)?\\s*(?:m/s\\^2|m/s|km/h|mph|ft|feet|foot|inch(?:es)?|cm|mm|km|miles?|second?s?|secs?|ms|\\bm\\b|\\bs\\b|\\bg\\b)",
  "authenticity_patterns": [
    "\\bfak(?:e|ed|es|ing)\\b",
    "\\bhoax\\w*\\b",
    "\\bstag(?:e|ed|ing)\\b",
    "\\bcgi\\b",
    "\\bai[\\s-]?generated\\b",
    "\\bslowed\\b",
    "\\bslow[\\s-]?motion\\b",
    "\\bsped\\s+up\\b",
    "\\bspeed\\s+up\\b",
    "\\bplayback\\b.{0,10}\\bspeed\\b",
    "\\bframe[\\s-]?rates?\\b",
    "\\bfps\\b",
    "\\bdebunk\\w*\\b",
    "\\bfact[\\s-]?checks?\\b",
    "\\breal\\s+or\\s+fake\\b",
    "\\bfake\\s+or\\s+real\\b",
    "\\bin\\s+the\\s+air\\b",
    "\\bair[\\s-]?time\\b",
    "\\bhang[\\s-]?time\\b",
    "\\bworld\\s+record\\b"
  ],
  "event_quantity_patterns": [
    "how\\s+(high|far|long|fast|tall)\\b.{0,60}\\b(jump|fall|flight|stunt|salute|record|video|footage|clip)\\w*\\b",
    "\\b(jump|fall|flight|stunt|salute)\\w*\\b.{0,60}\\bhow\\s+(high|far|long|fast|tall)\\b"
  ]
}
