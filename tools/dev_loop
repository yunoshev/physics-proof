def part_from_spec_rel(spec_rel: str) -> str | None:
    """Part number derived from the spec path (e.g. brief/11-... -> "11")."""
    match = re.search(r"(\d{1,2})", Path(spec_rel).name)
    if not match:
        return None
    return match.group(1).zfill(2)


def iteration_line_names_part(line: str, part: str) -> bool:
    """True when an ITERATIONS.md line records a generation of `part`.

    Lines look like ``DATE | part NN | ...``. Compare numerically so
    "05" and "5" match each other and nothing else matches.
    """
    try:
        want = int(part)
    except (TypeError, ValueError):
        return False
    for found in re.findall(r"\|\s*part\s+(\d+)\s*\|", f"| {line} |"):
        try:
            if int(found) == want:
                return True
        except ValueError:
            continue
    return False


def last_generation_commit(
    root: Path, part_or_owned: str | list[str] | None,
    owned: list[str] | None = None,
) -> str | None:
    """Newest commit holding the part's last generation, if any.

    Brief part 15 §17 (self-review 2026-10-30): the base is the newest
    commit that adds a line for this part to ITERATIONS.md. It is not
    the newest commit touching the part's owned paths -- a revert, a
    fixture fix or a README refresh by the owner must not move it.

    `part_or_owned` is the part number ("11"); the older owned-paths
    call shape is still accepted and resolves the part from the spec
    where possible, but the owned paths never set the base.
    """
    if isinstance(part_or_owned, list) or owned is not None:
        # Legacy call shape last_generation_commit(root, owned): no part
        # is known, so no ITERATIONS.md line can be matched.
        return None
    part = part_or_owned
    if not part:
        return None
    try:
        proc = subprocess.run(
            ["git", "log", "--format=%H", "--", ITERATIONS_REL],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            cwd=root,
        )
    except (OSError, ValueError):
        return None
    if proc.returncode != 0:
        return None
    commits = proc.stdout.decode("utf-8", errors="replace").split()
    for commit in commits:
        try:
            show = subprocess.run(
                ["git", "show", commit, "--format=", "--unified=0",
                 "--", ITERATIONS_REL],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                cwd=root,
            )
        except (OSError, ValueError):
            return None
        if show.returncode != 0:
            continue
        for line in show.stdout.decode("utf-8", errors="replace").splitlines():
            if line.startswith("+") and not line.startswith("+++"):
                if iteration_line_names_part(line[1:], str(part)):
                    return commit
    return None


def spec_changes_diff(
    root: Path, spec_rel: str, skill_rels: list[str], since: str,
) -> str:
    """Git diff of the prompt's spec inputs from `since` to HEAD (may be "")."""
    watched = [spec_rel]
    if spec_rel != SHARED_CONSTRAINTS_REL:
        watched.append(SHARED_CONSTRAINTS_REL)
    watched.extend(rel for rel in skill_rels if rel not in watched)
    try:
        proc = subprocess.run(
            ["git", "diff", f"{since}..HEAD", "--", *watched],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            cwd=root,
        )
    except (OSError, ValueError):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.decode("utf-8", errors="replace")


def build_spec_changes_section(
    root: Path, spec_rel: str, skill_rels: list[str],
    owned: list[str] | None = None,
    part: str | None = None,
) -> str:
    """The SPEC CHANGES prompt section: a diff, or a one-line no-changes."""
    resolved = part or part_from_spec_rel(spec_rel)
    since = last_generation_commit(root, resolved) if resolved else None
    if since is None:
        return f"{CHANGES_TITLE}\nno changes (no previous generation found)."
    diff = spec_changes_diff(root, spec_rel, skill_rels, since)
    if not diff.strip():
        return f"{CHANGES_TITLE}\n{NO_CHANGES_LINE}"
    return f"{CHANGES_TITLE}\n{CHANGES_INSTRUCTION}\n```diff\n{diff}\n```"


def build_prompt(
    root: Path, spec_rel: str, skill_rels: list[str],
    browser: bool = False, owned: list[str] | None = None,
    part: str | None = None,
) -> str:
    """The coding-agent prompt: one spec part + shared constraints + PLAN.md
    + relevant skills + the spec-changes diff (brief part 15 §8)."""
    spec_path = root / spec_rel
    plan_path = root / "PLAN.md"
    shared_path = root / SHARED_CONSTRAINTS_REL
    for path in (spec_path, plan_path, shared_path):
        if not path.is_file():
            raise DevLoopError(f"prompt input not found: {path}")
    chunks = [
        "Generate (or repair) ONLY the part described below. "
        "Write the part's owned code files and its owned test files; "
        "do not create or modify any other file.",
        f"=== SPEC PART: {spec_rel} ===\n" + spec_path.read_text(encoding="utf-8"),
        f"=== SHARED CONSTRAINTS: {SHARED_CONSTRAINTS_REL} ===\n"
        + shared_path.read_text(encoding="utf-8"),
        "=== PLAN.md ===\n" + plan_path.read_text(encoding="utf-8"),
    ]
    for rel in skill_rels:
        skill_path = root / rel
        if not skill_path.is_file():
            raise DevLoopError(f"prompt input not found: {skill_path}")
        chunks.append(
            f"=== SKILL: {rel} ===\n" + skill_path.read_text(encoding="utf-8")
        )
    chunks.append(
        build_spec_changes_section(
            root, spec_rel, skill_rels, owned,
            part=part or part_from_spec_rel(spec_rel),
        )
    )
    if browser:
        chunks.append(BROWSER_PROMPT)
    return "\n\n".join(chunks)


def parse_events(stdout_text: str) -> tuple[dict | None, dict | None]:
    """Last run_usage payload and last run_terminal payload, if any."""
    usage: dict | None = None
    terminal: dict | None = None
    for line in stdout_text.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        payload = event.get("payload")
        if not isinstance(payload, dict):
            continue
        kind = payload.get("kind")
        if kind == "run_usage":
            usage = payload
        elif kind == "run_terminal":
            terminal = payload
    return usage, terminal


def run_muse(
    *, model: str, effort: str, max_steps: int, workspace: Path, prompt: str,
    browser: bool = False,
) -> dict:
    """Invoke Muse per skills/muse-code-headless.md; return usage+terminal.

    The API key travels on stdin only (--api-key-stdin). It never appears in
    argv, in the prompt, or in any file or log this tool writes.

    Parts that build a screen (registry ``"browser": true``, brief part 15
    §8) run outside the shell sandbox -- headless Chrome cannot start
    inside it, and outside it does -- with PHYSICS_PROOF_BROWSER=1 in the
    agent's environment so its own browser tests can run.
    """
    key = os.environ.get("META_API_KEY")
    if not key:
        raise DevLoopError(
            "META_API_KEY is not set; refusing to invoke the coding agent"
        )
    argv = [
        "muse", "exec", "--api-key-stdin", "--json",
        "--model", model,
        "--reasoning-effort", effort,
        "--max-model-steps", str(max_steps),
        "--no-foreign-personal-context",
        "--disable-reminders",
        "--trust-workspace",
        "--approval-mode", "never",
        "--sandbox-network", "enabled",
        "--workspace", str(workspace),
    ]
    env = dict(os.environ)
    if browser:
        argv.append("--disable-sandbox")
        env[BROWSER_ENV] = "1"
    argv.append(prompt)
    proc = subprocess.run(
        argv,
        input=key.encode("utf-8"),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        cwd=workspace,
        env=env,
    )
    stdout_text = proc.stdout.decode("utf-8", errors="replace")
    usage, terminal = parse_events(stdout_text)
    return {
        "usage": usage,
        "terminal": terminal,
        "returncode": proc.returncode,
        "stderr": proc.stderr.decode("utf-8", errors="replace")[-2000:],
        "stdout_text": stdout_text,
    }


def price_usage(usage: dict | None) -> tuple[float | None, str]:
    """Convert a run_usage payload to dollars; unknown model -> cost unknown."""
    if not usage or not usage.get("models"):
        return None, "no usage reported"
    total = 0.0
    unknown: list[str] = []
    bits: list[str] = []
    for entry in usage["models"]:
        name = str(entry.get("model", "?"))
        try:
            in_tokens = int(entry.get("input_tokens", 0))
            cached = int(entry.get("cached_tokens", 0))
            out_tokens = int(entry.get("output_tokens", 0))
            calls = int(entry.get("calls", 0))
        except (TypeError, ValueError):
            continue
        bits.append(
            f"{name}: in {in_tokens} cached {cached} "
            f"out {out_tokens} calls {calls}"
        )
        prices = PRICES.get(name)
        if prices is None:
            unknown.append(name)
            continue
        total += (
            (in_tokens - cached) * prices["input"]
            + cached * prices["cached"]
            + out_tokens * prices["output"]
        ) / 1_000_000
    if unknown or not bits:
        return None, "; ".join(bits) if bits else "no usage reported"
    return total, "; ".join(bits)


def run_part_tests(
    test_command: list[str], cwd: Path, browser: bool = False,
) -> tuple[int, str]:
    """Run the part's test command; return (exit code, full output).

    Callers slice the tail for agent feedback; the record keeps the full text.
    Screen-building parts (brief part 15 §8) run their tests with
    PHYSICS_PROOF_BROWSER=1 so the headless-Chrome checks can run;
    every other part keeps the sandbox.
    """
    env = dict(os.environ)
    if browser:
        env[BROWSER_ENV] = "1"
    proc = subprocess.run(
        test_command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        cwd=cwd,
        text=True,
        env=env,
    )
    return proc.returncode, proc.stdout


