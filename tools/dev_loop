IGNORED_NAMES = {"__pycache__", ".pytest_cache", ".DS_Store"}
IGNORED_SUFFIXES = (".pyc", ".pyo")


def is_ignored(root: Path, path: Path) -> bool:
    """True for interpreter-cache byproducts under root (never generated files)."""
    try:
        rel_parts = path.relative_to(root).parts
    except ValueError:
        return True
    return any(part in IGNORED_NAMES for part in rel_parts) or path.suffix in (
        IGNORED_SUFFIXES
    )


def iter_owned_files(root: Path, owned: list[str]) -> list[Path]:
    """Existing source files under the part's owned paths, sorted.

    Interpreter caches (__pycache__, *.pyc) and similar byproducts are not
    generated files in the part-15 sense, so they are skipped everywhere:
    they neither trip the hand-edit check nor get recorded or deleted.
    """
    found: list[Path] = []
    for rel in owned:
        target = root / rel
        if (
            target.is_file()
            and not target.is_symlink()
            and not is_ignored(root, target)
        ):
            found.append(target)
        elif target.is_dir() and not target.is_symlink():
            for child in sorted(target.rglob("*")):
                if (
                    child.is_file()
                    and not child.is_symlink()
                    and not is_ignored(root, child)
                ):
                    found.append(child)
    return sorted(found)


def file_sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def header_part(path: Path) -> str | None:
    """Part number from the courtesy header, or None if absent.

    Display helper only; the hand-edit guard never calls this.
    """
    try:
        with path.open(encoding="utf-8", errors="replace") as handle:
            for _ in range(5):
                line = handle.readline()
                if not line:
                    break
                match = HEADER_RE.search(line)
                if match:
                    return match.group(1).zfill(2)
    except OSError:
        return None
    return None


def load_manifest(path: Path) -> dict:
    if not path.exists():
        return {"version": 1, "files": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise DevLoopError(f"manifest is not valid JSON: {path}: {exc}")
    if not isinstance(data, dict) or not isinstance(data.get("files"), dict):
        raise DevLoopError(f"manifest has the wrong shape: {path}")
    return data


def check_clean(
    root: Path, part: str, owned: list[str], manifest: dict
) -> list[str]:
    """Files under owned paths that fail the hand-edit check.

    The manifest hash is the whole check: a file is clean when it has a
    manifest entry with a matching SHA-256. A hash mismatch, or a file
    under owned paths that the manifest doesn't list (edited by hand,
    added by hand, or generated before the manifest existed), is a
    violation. The courtesy header is never a violation. Missing files
    are fine: they are (re)generated below.
    """
    violations: list[str] = []
    recorded = manifest.get("files", {})
    for path in iter_owned_files(root, owned):
        rel = path.relative_to(root).as_posix()
        entry = recorded.get(rel)
        if entry is None or entry.get("sha256") != file_sha256(path):
            violations.append(rel)
    return sorted(violations)


def delete_owned(root: Path, owned: list[str], keep: set[Path]) -> list[str]:
    """Delete exactly the part's owned paths (files or trees), nothing else."""
    deleted: list[str] = []
    for rel in owned:
        target = root / rel
        resolved = target.resolve() if target.exists() else None
        if resolved is not None and resolved in keep:
            continue
        if target.is_file() or target.is_symlink():
            target.unlink()
            deleted.append(rel)
        elif target.is_dir():
            shutil.rmtree(target)
            deleted.append(rel)
    return sorted(deleted)


